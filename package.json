{
	"name": "murjan",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "npm run dev -w apps/storefront",
		"build": "npm run build -w apps/storefront",
		"start": "npm run start -w apps/storefront",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:e2e": "npm run test:e2e -w apps/storefront"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-config-next": "^15.5.27",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.9.9",
		"vitest": "^3.2.7"
	}
}
